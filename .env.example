# Neon pooled connection string. App queries use this.
DATABASE_URL=

# Neon direct connection string. Migrations and seed scripts use this.
DATABASE_URL_UNPOOLED=

# Clerk. Without these the app boots, but sign-in and writes are unavailable.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Cloudflare R2. All five are required for uploads.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL, no trailing slash.
R2_PUBLIC_URL=

# Bearer token for /api/cron/purge-accounts and /api/cron/expire-ad-checkouts.
CRON_SECRET=

# Dodo Payments. Required together for ad checkout.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode or live_mode. Anything else stays in test mode.
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Upstash Redis REST credentials. Required in production for search, upload,
# page-view, and click rate limits. Leave unset locally to skip the limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site origin, no trailing slash.
# Required outside localhost. Checkout return URLs use this.
# Locally, http://localhost:3000 is a safe fallback when this is unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000
