{
  "name": "gamebits",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "npm run db:generate -w @gamebits/db",
    "db:migrate": "npm run db:migrate -w @gamebits/db",
    "db:push": "npm run db:push -w @gamebits/db",
    "db:seed": "npm run db:seed -w @gamebits/db"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}
